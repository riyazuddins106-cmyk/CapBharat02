# Supabase project credentials (Settings > API in your Supabase dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string (Settings > Database > Connection string, URI format)
SUPABASE_DATABASE_URL=

# JWT signing secrets - use long random strings
JWT_SECRET=
JWT_REFRESH_SECRET=

# Backend server port (never exposed directly, proxied by the frontend dev server)
PORT=8000

# SMTP email delivery for signup / password-reset OTP codes (optional).
# Works with any SMTP provider (Resend, SendGrid, Gmail, Mailgun, etc).
# Until these are set, OTP codes are just logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ServeNow <no-reply@servenow.in>"

# Fast2SMS API key for SMS / OTP delivery (https://fast2sms.com → API > Dev API)
# Optional — if absent, OTP codes are only logged to the server console.
FAST2SMS_API_KEY=

# ── Mobile app (Expo) ──────────────────────────────────────────────────────────
# Set in apps/mobile/.env and apps/mobile-partner/.env (not this root file).
# During development the Expo dev server derives this automatically from the
# ngrok tunnel or REPLIT_EXPO_DEV_DOMAIN. Only needed for standalone/EAS builds.
EXPO_PUBLIC_API_URL=https://your-production-domain.com
