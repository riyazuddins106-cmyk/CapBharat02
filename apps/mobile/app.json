{
  "expo": {
    "name": "ServeNow",
    "slug": "servenow",
    "owner": "riyazuddinss-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "servenow",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "jsc",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f8fa"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servenow.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#5b3ef5"
      },
      "package": "com.servenow.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/a290a039-c096-4437-aa82-0f43b13e08b1"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ServeNow to access your camera to scan QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appStoreId": "",
      "playStoreId": "",
      "eas": {
        "projectId": "a290a039-c096-4437-aa82-0f43b13e08b1"
      },
      "router": {
        "origin": "https://f3d47d71-5544-4408-ad75-c68024a63ea8-00-1cffxziop2eun.sisko.replit.dev",
        "headOrigin": "https://f3d47d71-5544-4408-ad75-c68024a63ea8-00-1cffxziop2eun.sisko.replit.dev"
      }
    }
  }
}
